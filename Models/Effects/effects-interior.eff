<?xml version="1.0" encoding="utf-8"?>

<PropertyList>
    <name>interior</name>
    <inherits-from>Effects/model-interior</inherits-from>
    <parameters>
        <texture n="4">
            <type>cubemap</type>
            <images>
                <positive-x>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0004.png</positive-x>
                <negative-x>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0002.png</negative-x>
                <positive-y>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0001.png</positive-y>
                <negative-y>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0003.png</negative-y>
                <positive-z>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0006.png</positive-z>
                <negative-z>Aircraft/DR400-dauphin/Models/Effects/Textures/Cubemap/Shadows/0005.png</negative-z>
            </images>
        </texture>
        <opacity-cube-center type="vec3d" n="0"> -1.37408 0.009582 0.633576 </opacity-cube-center>
        <opacity-cube-scale type="vec3d" n="0"> 0.672322 0.672322 0.672322</opacity-cube-scale>
        <light-filter-one type="vec3d">0.5 0.5 0.5</light-filter-one>
        <light-filter-two type="vec3d">0.9 0.2 0.2</light-filter-two>
        <light-radius type="float">13</light-radius>
        <irradiance-map-type type="int">2</irradiance-map-type>
        <irradiance-map-strength type="float">0.25</irradiance-map-strength>
	<residual-ambience-r type="float">0.02</residual-ambience-r>
	<residual-ambience-g type="float">0.01</residual-ambience-g>
	<residual-ambience-b type="float">0.00</residual-ambience-b>
    </parameters>
</PropertyList>
