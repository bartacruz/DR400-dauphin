  <!-- Alarme visuelle pression huile-->
  <!-- Allumé si pression d'huile inférieur à 14PSI -->
  <!-- EN: Oil pressure alarm -->  
  <animation>
    <type>select</type>
    <object-name>warning01.on</object-name>
    <condition>
    <property>/instrumentation/annunciators/engines/oil-pressure-low</property>
    </condition>
  </animation>
  
  <!-- Alarme visuelle pression essence -->
  <!-- Allumé si pression carburant inférieur à 1.1PSI-->
  <!-- EN: Fuel pressure alarm -->
  <animation>
    <type>select</type>
    <object-name>warning02.on</object-name>
    <condition>
      <property>/instrumentation/annunciators/systems/fuel/pressure-low</property>
    </condition>
  </animation>
  
  <!-- Alarmes fuel 1 litre= 0.264172052 gallons -->
  <!-- Allumé si quantité carburant inférieur à 10 litres -->
  <!-- EN: Fuel qty alarm --> 
  <animation>
    <type>select</type>
    <object-name>warning03.on</object-name>
    <condition>
      <property>/instrumentation/annunciators/systems/fuel/fuel-low</property>
    </condition>
  </animation>
   
  <!-- Alarme visuelle décharge batterie-->
  <!-- Allumé si le moteur tourne pas et/ou l'alternateur non engagé -->
  <!-- EN: Battery charge alarm -->
  <animation>
    <type>select</type>
    <object-name>warning04.on</object-name>
    <condition>
    <property>/instrumentation/annunciators/systems/electric/battery-charge</property>
    </condition>
  </animation>
  
  <!-- Demarreur -->
  <!-- Allumé si tension démarreur supérieur à 8V-->
  <!-- EN: Starter indicator -->
  <animation>
    <type>select</type>
    <object-name>warning05.on</object-name>
    <condition>
    <property>/instrumentation/annunciators/engines/engine[0]/starter</property>
    </condition>
  </animation>
  
  <!-- Alarme visuelle volets -->
  <!-- Allumé si volet(s) sorti -->
  <!-- EN: Flaps extended indicator-->
  <animation>
    <type>select</type>
    <object-name>warning06.on</object-name>
    <condition>
      <property>/instrumentation/annunciators/flaps</property>
    </condition>
  </animation>
  
  <!-- Pitot-->
  <!-- Allumé si tension pitot supérieur à 8V -->
  <!-- EN: Pitot indicator TODO: afaik we don't have a pitot heater...-->
  <animation>
    <type>select</type>
    <object-name>warning07.on</object-name>
    <condition>
      <and>
        <or>
          <greater-than-equals>
            <property>systems/electrical/outputs/pitot</property>
            <value> 8 </value> 
          </greater-than-equals>
          <property>controls/lighting/warning-test</property>
        </or>
        <property>controls/electric/battery-switch</property>
      </and>
    </condition>
  </animation>
  
   <animation>
    <type>material</type>
    <object-name>warning01</object-name>
    <object-name>warning02</object-name>
    <object-name>warning03</object-name>
    <object-name>warning04</object-name>
    <object-name>warning05</object-name>
    <object-name>warning06</object-name>
    <object-name>warning07</object-name>
    <object-name>warning08</object-name>
    <emission>
      <red>   0 </red>
      <green> 0 </green>
      <blue>  0 </blue>
    </emission>
  </animation>
  
   <animation>
    <type>material</type>
    <object-name>warning01.on</object-name>
    <object-name>warning02.on</object-name>
    <object-name>warning03.on</object-name>
    <object-name>warning04.on</object-name>
    <object-name>warning05.on</object-name>
    <object-name>warning06.on</object-name>
    <object-name>warning07.on</object-name>
    <object-name>warning08.on</object-name>
    <condition>
      <or>
        <not><property>controls/lighting/warning-mode</property></not>
        <property>controls/lighting/warning-test</property>
      </or>
    </condition>
    <emission>
      <red>   0.035 </red>
      <green> 0.035 </green>
      <blue>  0.035 </blue>
      <factor-prop>systems/electrical/volts</factor-prop>
    </emission>
  </animation>

   <animation>
    <type>material</type>
    <object-name>warning01.on</object-name>
    <object-name>warning02.on</object-name>
    <object-name>warning03.on</object-name>
    <object-name>warning04.on</object-name>
    <object-name>warning05.on</object-name>
    <object-name>warning06.on</object-name>
    <object-name>warning07.on</object-name>
    <object-name>warning08.on</object-name>
    <condition>
      <property>controls/lighting/warning-mode</property>
    </condition>
    <emission>
      <red>   0.012 </red>
      <green> 0.012 </green>
      <blue>  0.012 </blue>
      <factor-prop>systems/electrical/volts</factor-prop>
    </emission>
