				<value>1</value>
			</not-equals>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>gtx328.screen.day</object-name>
		<condition>
			<greater-than-equals>
				<property>rendering/scene/diffuse/red</property>
				<value>0.7</value>
			</greater-than-equals>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>gtx328.screen.night</object-name>
		<condition>
			<less-than>
				<property>rendering/scene/diffuse/red</property>
				<value>0.7</value>
			</less-than>
		</condition>
	</animation>
	
